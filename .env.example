# Salin fail ni kepada .env dan isi dengan nilai sebenar
# JANGAN commit fail .env (sudah ada dalam .gitignore)

# --- Firebase (Auth + Firestore) ---
# Dari Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Google Drive upload (Apps Script) ---
# Dari langkah deploy Apps Script - lihat appscript/Code.gs untuk arahan penuh
VITE_APPS_SCRIPT_URL=
VITE_DRIVE_UPLOAD_SECRET=
