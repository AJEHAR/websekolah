rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin ditentukan oleh kewujudan dokumen di koleksi 'admins' dengan
    // ID = emel admin. Contoh: admins/pengetua@moe-dl.edu.my
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    function isPemilik(emelDokumen) {
      return request.auth != null && request.auth.token.email == emelDokumen;
    }

    match /admins/{emelAdmin} {
      allow read: if request.auth != null;
      allow create: if isAdmin();
      // Sekatan tambahan: admin tak boleh buang rekod admin diri sendiri
      // (sekatan "mesti ada sekurang-kurangnya 1 admin" diuruskan di client)
      allow delete: if isAdmin() && emelAdmin != request.auth.token.email;
    }

    match /profiles/{docId} {
      // Semua staff yang log masuk boleh baca (termasuk No. IC)
      allow read: if request.auth != null;

      // Self-register: staff cipta profile sendiri MESTI status='menunggu'
      // (elak staff terus set diri sendiri 'diluluskan'). Admin boleh cipta apa-apa status.
      allow create: if isAdmin() ||
        (isPemilik(request.resource.data.emel) && request.resource.data.status == 'menunggu');

      // Self-edit: staff boleh kemas kini profile sendiri TAPI TAK BOLEH ubah field 'status'
      // (elak self-approve). Admin boleh ubah apa-apa termasuk status (kelulusan).
      allow update: if isAdmin() ||
        (isPemilik(resource.data.emel) && request.resource.data.status == resource.data.status);

      allow delete: if isAdmin();
    }

    // Koleksi utama 'kehadiran' - rekod keberadaan semua staff.
    // Guna koleksi utama (bukan sub-koleksi) supaya query "Hari Ini/Esok"
    // merentasi semua staff senang dan cekap.
    match /kehadiran/{docId} {
      // Semua staff log masuk boleh baca (perlu untuk Hari Ini/Esok/Log)
      allow read: if request.auth != null;

      // Admin boleh cipta/edit rekod sesiapa sahaja.
      // Staff biasa hanya boleh cipta/edit rekod dia sendiri (padan emel).
      allow create: if isAdmin() || isPemilik(request.resource.data.profilEmel);
      allow update: if isAdmin() || isPemilik(resource.data.profilEmel);
      allow delete: if isAdmin() || isPemilik(resource.data.profilEmel);
    }

    // Kumpulan Guru Bertugas & senarai Tugas kongsi - semua staff log masuk
    // boleh baca (perlu tahu kumpulan/tugas sendiri), admin sahaja boleh urus.
    match /kumpulanBertugas/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /tugasBertugas/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Blok Laporan 3K (Pentadbiran/Akademik/Sokongan/Kantin, dll) - admin urus.
    match /blokLaporan3K/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Rekod Laporan 3K harian - mana-mana staff log masuk boleh isi/kemas kini
    // (bukan admin sahaja, sebab sesiapa boleh jadi guru bertugas yang isi laporan).
    match /laporan3K/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Maklumat Murid - semua staff log masuk boleh baca (umum, macam Keberadaan).
    // Import/edit/padam admin sahaja (data ni sangat sensitif - IC penjaga, kewangan, OKU).
    match /murid/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
