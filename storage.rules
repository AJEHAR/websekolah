rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Gambar profile - profil/{...}
    match /profil/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Dokumen berkaitan keberadaan - kehadiran/{...}
    match /kehadiran/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
